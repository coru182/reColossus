 #include <map>
 #include <chrono>
 #include "runtime/native_renderer.h"
@@ -3461,7 +3462,14 @@
     if (snapshot.empty())
         return {};
 
+#if defined(PLATFORM_PS5)
+    // The PS5 target allows thread-locals aligned to 32 bytes at most: the backend (its page cache is aligned to 64)
+    // on the heap instead, one per thread as before.
+    thread_local std::unique_ptr<GSCpuBackend> snapshotOwner = std::make_unique<GSCpuBackend>();
+    GSCpuBackend &snapshotBackend = *snapshotOwner;
+#else
     thread_local GSCpuBackend snapshotBackend;
+#endif
     snapshotBackend.Initialize(snapshot.data(), static_cast<uint32_t>(snapshot.size()));
     PresentationFrame frame = snapshotBackend.PresentFromLocalMemory(request);
     // A game override drawing natively (runtime/native_renderer.h) shows its picture instead.
